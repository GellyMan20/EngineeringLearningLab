"""
Monte Carlo Advanced Methods Example

Includes:
1. Correlated variables
2. Latin Hypercube Sampling
3. Tornado plot sensitivity analysis

System:
Simple vertical rocket altitude model.

Inputs:
- Mass
- Thrust
- Fuel time
- Drag coefficient

Output:
- Maximum altitude
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import norm


# ============================================================
# SETTINGS
# ============================================================

np.random.seed(42)

N = 5000
GRAVITY = 9.81
DT = 0.05


# ============================================================
# ROCKET MODEL
# ============================================================

def run_rocket_simulation(mass, thrust, fuel_time, drag_coefficient):
    height = 0.0
    velocity = 0.0
    time = 0.0
    max_height = 0.0

    while True:
        if time < fuel_time:
            thrust_accel = thrust / mass
        else:
            thrust_accel = 0.0

        drag_accel = drag_coefficient * velocity * abs(velocity) / mass

        if velocity > 0:
            acceleration = thrust_accel - GRAVITY - drag_accel
        else:
            acceleration = thrust_accel - GRAVITY + drag_accel

        velocity += acceleration * DT
        height += velocity * DT
        time += DT

        max_height = max(max_height, height)

        if height <= 0 and time > fuel_time:
            break

        if time > 120:
            break

    return max_height


# ============================================================
# PART 1 — CORRELATED VARIABLE SAMPLING
# ============================================================

def generate_correlated_samples(n):
    """
    Example correlation idea:

    Heavier rockets tend to have:
    - slightly higher thrust
    - slightly longer fuel burn time

    This is realistic because a bigger propulsion package may
    increase both mass and impulse.
    """

    means = np.array([
        1.00,   # mass, kg
        15.0,   # thrust, N
        5.00,   # fuel time, s
        0.020   # drag coefficient
    ])

    stds = np.array([
        0.08,
        1.50,
        0.45,
        0.004
    ])

    correlation_matrix = np.array([
        [1.00,  0.60,  0.45,  0.10],
        [0.60,  1.00,  0.50,  0.05],
        [0.45,  0.50,  1.00,  0.00],
        [0.10,  0.05,  0.00,  1.00]
    ])

    covariance_matrix = np.diag(stds) @ correlation_matrix @ np.diag(stds)

    samples = np.random.multivariate_normal(
        mean=means,
        cov=covariance_matrix,
        size=n
    )

    df = pd.DataFrame(
        samples,
        columns=["mass", "thrust", "fuel_time", "drag_coefficient"]
    )

    df["mass"] = df["mass"].clip(0.6, 1.5)
    df["thrust"] = df["thrust"].clip(8.0, 25.0)
    df["fuel_time"] = df["fuel_time"].clip(2.0, 8.0)
    df["drag_coefficient"] = df["drag_coefficient"].clip(0.005, 0.050)

    return df


# ============================================================
# PART 2 — LATIN HYPERCUBE SAMPLING
# ============================================================

def latin_hypercube_normal(n, means, stds):
    """
    Latin Hypercube Sampling:

    Instead of randomly drawing all points freely,
    each input distribution is divided into N probability bands.

    One sample is drawn from each band.

    This gives better coverage than plain random sampling,
    especially when N is smaller.
    """

    num_variables = len(means)
    lhs = np.zeros((n, num_variables))

    for j in range(num_variables):
        probability_bins = (np.arange(n) + np.random.random(n)) / n
        np.random.shuffle(probability_bins)

        lhs[:, j] = norm.ppf(
            probability_bins,
            loc=means[j],
            scale=stds[j]
        )

    return lhs


def generate_lhs_samples(n):
    means = np.array([1.00, 15.0, 5.00, 0.020])
    stds = np.array([0.08, 1.50, 0.45, 0.004])

    lhs_samples = latin_hypercube_normal(n, means, stds)

    df = pd.DataFrame(
        lhs_samples,
        columns=["mass", "thrust", "fuel_time", "drag_coefficient"]
    )

    df["mass"] = df["mass"].clip(0.6, 1.5)
    df["thrust"] = df["thrust"].clip(8.0, 25.0)
    df["fuel_time"] = df["fuel_time"].clip(2.0, 8.0)
    df["drag_coefficient"] = df["drag_coefficient"].clip(0.005, 0.050)

    return df


# ============================================================
# RUN MONTE CARLO
# ============================================================

def run_campaign(samples_df, campaign_name):
    max_heights = []

    for _, row in samples_df.iterrows():
        max_height = run_rocket_simulation(
            mass=row["mass"],
            thrust=row["thrust"],
            fuel_time=row["fuel_time"],
            drag_coefficient=row["drag_coefficient"]
        )

        max_heights.append(max_height)

    samples_df = samples_df.copy()
    samples_df["max_height"] = max_heights
    samples_df["campaign"] = campaign_name

    return samples_df


correlated_samples = generate_correlated_samples(N)
lhs_samples = generate_lhs_samples(N)

correlated_results = run_campaign(correlated_samples, "Correlated Monte Carlo")
lhs_results = run_campaign(lhs_samples, "Latin Hypercube Sampling")

all_results = pd.concat(
    [correlated_results, lhs_results],
    ignore_index=True
)


# ============================================================
