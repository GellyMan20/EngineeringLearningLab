# ============================================================
# PART 3 — TORNADO PLOT
# ============================================================

def tornado_sensitivity_analysis(base_case):
    """
    Tornado plot method:

    Hold everything at nominal values.
    Change one variable low/high.
    Measure output swing.

    Bigger swing = more sensitive variable.
    """

    variables = {
        "mass": {
            "low": 0.90,
            "high": 1.10
        },
        "thrust": {
            "low": 13.0,
            "high": 17.0
        },
        "fuel_time": {
            "low": 4.3,
            "high": 5.7
        },
        "drag_coefficient": {
            "low": 0.012,
            "high": 0.028
        }
    }

    base_output = run_rocket_simulation(**base_case)

    rows = []

    for variable, bounds in variables.items():
        low_case = base_case.copy()
        high_case = base_case.copy()

        low_case[variable] = bounds["low"]
        high_case[variable] = bounds["high"]

        low_output = run_rocket_simulation(**low_case)
        high_output = run_rocket_simulation(**high_case)

        rows.append({
            "variable": variable,
            "low_output": low_output,
            "high_output": high_output,
            "swing": abs(high_output - low_output)
        })

    tornado_df = pd.DataFrame(rows)
    tornado_df = tornado_df.sort_values("swing", ascending=True)

    return tornado_df, base_output


base_case = {
    "mass": 1.00,
    "thrust": 15.0,
    "fuel_time": 5.00,
    "drag_coefficient": 0.020
}

tornado_df, base_output = tornado_sensitivity_analysis(base_case)

print("\nTORNADO SENSITIVITY TABLE")
print(tornado_df)


# ============================================================
# PLOT 4 — TORNADO PLOT
# ============================================================

plt.figure(figsize=(9, 6))

for _, row in tornado_df.iterrows():
    low = row["low_output"]
    high = row["high_output"]

    plt.plot(
        [low, high],
        [row["variable"], row["variable"]],
        linewidth=8
    )

plt.axvline(base_output, linestyle="--", label="Base Case")

plt.title("Tornado Plot: Sensitivity of Max Altitude")
plt.xlabel("Maximum Altitude")
plt.ylabel("Input Variable")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()


